{
  "name": "@ofdrw/ofdrw-viewer-ui",
  "version": "0.1.0",
  "description": "框架无关的 OFD 阅读器 UI（核心 + Web Component/React/Vue 薄适配）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./component": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ofd",
    "ofdrw",
    "ofd-viewer",
    "document-reader",
    "web-component",
    "react",
    "vue",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofdrw/ofdrw-viewer.git",
    "directory": "packages/ofdrw-viewer-ui"
  },
  "homepage": "https://github.com/ofdrw/ofdrw-viewer#readme",
  "bugs": {
    "url": "https://github.com/ofdrw/ofdrw-viewer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p site/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "preview:site": "vite preview --config site/vite.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ofdrw/ofdrw-viewer-crypto": "workspace:^",
    "@ofdrw/ofdrw-viewer-engine": "workspace:^",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}