{
  "name": "@ofdrw/ofdrw-viewer-cli",
  "version": "0.1.4",
  "description": "OFD 转图片命令行工具（@ofdrw/ofdrw-viewer-engine 的 Node 子包）",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ofdrw-viewer-cli": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ofd",
    "ofdrw",
    "ofd-converter",
    "ofd-to-image",
    "cli",
    "png",
    "jpeg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofdrw/ofdrw-viewer.git",
    "directory": "packages/ofdrw-viewer-cli"
  },
  "homepage": "https://github.com/ofdrw/ofdrw-viewer#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:acceptance": "pnpm run build && pnpm run build:sea && vitest run --config test/acceptance/vitest.config.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node -e \"if(process.platform!=='win32')require('node:fs').chmodSync('dist/bin.js',0o755)\"",
    "build:sea": "node scripts/build-sea.mjs",
    "package:sea": "node scripts/package-sea.mjs",
    "release:sea": "pnpm run build:sea && pnpm run package:sea",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@ofdrw/ofdrw-viewer-crypto": "workspace:*",
    "@ofdrw/ofdrw-viewer-engine": "workspace:*"
  }
}