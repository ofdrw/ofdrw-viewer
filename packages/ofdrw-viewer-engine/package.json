{
  "name": "@ofdrw/ofdrw-viewer-engine",
  "version": "0.1.1",
  "description": "平台无关的 OFD 页面渲染引擎",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js",
      "require": "./dist/compat.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./src/compat.ts",
    "./dist/compat.js",
    "./dist/compat.cjs",
    "./dist/chunk-*.js",
    "./dist/chunk-*.cjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ofd",
    "ofdrw",
    "ofd-render",
    "document",
    "renderer",
    "canvas",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofdrw/ofdrw-viewer.git",
    "directory": "packages/ofdrw-viewer-engine"
  },
  "homepage": "https://github.com/ofdrw/ofdrw-viewer#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/build-cdn.mjs",
    "build:cdn": "node scripts/build-cdn.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:golden": "vitest run test/golden --passWithNoTests",
    "test:audit": "node scripts/audit-strict.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^26.6.5",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
