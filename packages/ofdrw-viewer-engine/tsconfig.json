{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@ofdrw/ofdrw-viewer-engine": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../test/**/*.ts"]
}