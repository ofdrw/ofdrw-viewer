node_modules/
dist/
dist.bak/
coverage/
.npm-cache/
.pnpm-store/
*.tsbuildinfo
*.log
.DS_Store
.env
.env.*

# 测试 / 冒烟脚本产物（按任务隔离，不提交）
**/test/.artifacts/
**/test/.fixtures/
examples/*/dist/
# 在线演示站构建产物（由 CI 构建并部署到 GitHub Pages）
site-dist/

# 字体处理临时工作目录（scripts/build-site-fonts.py 的中间产物，不入库）
.fontcheck/
.venv-fonts/

# 发布工作流在本地运行时生成的中间产物
release-assets/
release-notes.md

# 本地参考源码与素材，不纳入版本管理
/references/
/src_material/


# AgentTeams / 浏览器调试运行状态，不纳入版本管理
/.agent-teams/
/.playwright-cli/
/.research/
/.cache/
/.vhs*/

# 根目录示例构建产物；文档 GIF 的逐帧中间图不提交（最终 GIF 已提交）
/ofd-render-showcase/
/docs/img/ofd-render-showcase/

# 仅忽略根目录 test/ 下的本地产物，测试源码与基准图正常纳入版本管理
/test/.artifacts/
/test/.fixtures/
/test/acceptance/artifacts/
# 注：test/acceptance/artifacts/ 中已跟踪的基准图不受忽略影响；新增基准图需 git add -f

# 本地工具与浏览器配置
/.tmp*
/.pki/
/.config/
/.local/

# Python 字节码（scripts/ 下的字体工具脚本）
__pycache__/
